# Copy to .env and fill in what you need. .env is gitignored; this file is not.
#
# Every value below is optional. A missing key does not stop the app from
# starting: that provider is disabled, and a disabled provider degrades a run
# rather than ending it. Nothing here is required to import the package or to
# run the test suite.

# -- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Structured JSON logs instead of human-readable text.
LOG_JSON=false
# Authenticates API callers when set. Unset means the app runs open, which is
# the right default for local development and the wrong one anywhere else.
# API_KEY=
# CORS_ORIGINS=["http://localhost:3000"]

# -- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./competitor_analysis.db
DB_ECHO=false
CHROMA_PERSIST_DIRECTORY=./data/chroma
# REDIS_URL=redis://localhost:6379/0

# -- Provider credentials ---------------------------------------------------
# OpenAI: chat and embeddings. Set either one to use that vendor.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Any OpenAI-compatible gateway (LiteLLM, vLLM, OpenRouter, a local proxy).
# OPENAI_BASE_URL=

# Gemini: an alternative chat vendor.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tavily: web search.
# TAVILY_API_KEY=

# Firecrawl: rendered-page retrieval, for pages that need JavaScript.
# FIRECRAWL_API_KEY=

# -- Provider selection -----------------------------------------------------
# "auto" picks the first configured provider and falls back cleanly.
LLM_PROVIDER=auto
SEARCH_PROVIDER=auto
WEB_PROVIDER=auto
VECTOR_STORE_PROVIDER=auto
GRAPH_STORE_PROVIDER=memory

# -- Model roles ------------------------------------------------------------
# Each role is seeded from the configured vendor model when left unset, and may
# be set individually so roles can be split across vendors.
# FAST_MODEL=gpt-4o-mini
# REASONING_MODEL=gpt-4o
# FINAL_MODEL=gpt-4o

# -- Feature flags ----------------------------------------------------------
# When false the graph store is never touched, not merely ignored.
GRAPH_RAG_ENABLED=false
# The browser provider is used for pages that server-side retrieval cannot read.
# Needs `playwright install chromium` as well as the key-free package.
ENABLE_BROWSER_USE=true
ENABLE_RERANKING=false
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-competitor-analysis

# -- Budgets and limits -----------------------------------------------------
# Every limit here exists so a run terminates and says why. Raising one raises
# cost as well as time.
COMPETITOR_COUNT=5
RESEARCH_DEPTH=standard
MAX_SEARCH_RESULTS=10
MAX_QUERIES=20
MAX_SEARCH_QUERIES_PER_COMPETITOR=15
MAX_PAGES_PER_COMPETITOR=40
MAX_DOCUMENT_BYTES=5000000
MAX_DOCUMENT_CHARS=100000
MAX_LLM_TOKENS=12000
MAX_BROWSER_STEPS=20
MAX_REPORT_REPAIR_ROUNDS=2
MAX_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_COMPETITORS=3
MAX_CONCURRENT_AGENTS=5
MAX_REDIRECTS=3
ALLOWED_URL_PORTS=80,443,8080,8443

# -- Timeouts (seconds) -----------------------------------------------------
HTTP_TIMEOUT=30
SEARCH_TIMEOUT=30
BROWSER_TIMEOUT=60
LLM_TIMEOUT=120
CRAWL_TIMEOUT=300

# -- Output -----------------------------------------------------------------
REPORT_LANGUAGE=en
# Identifies the crawler to the sites it visits. Kept factual on purpose: it
# used to claim "respects robots.txt", which nothing in the code implements.
USER_AGENT=open-competitor-lens/0.1 (+competitive research)
